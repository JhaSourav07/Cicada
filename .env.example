# ==============================================================================
# CICADA Environment Configuration
# ==============================================================================
# All services bind strictly to localhost (127.0.0.1) for local-first privacy.
# DO NOT prefix internal service URLs with NEXT_PUBLIC_ to prevent browser leaks.

# Application Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Phase 2: Local AI Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5-9b-32k

# Phase 3: Database Persistence (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/cicada

# Phase 4: Internet Search (SearXNG)
SEARXNG_BASE_URL=http://127.0.0.1:8080

# Phase 7: Telegram Integration (Future)
# TELEGRAM_BOT_TOKEN=your_token_here
